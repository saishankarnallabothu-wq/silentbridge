{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "meshBridge.js", "use": "@vercel/static" },
    { "src": "paho-mqtt.js", "use": "@vercel/static" },
    { "src": "audioModem.js", "use": "@vercel/static" },
    { "src": "packetEngine.js", "use": "@vercel/static" },
    { "src": "crc16.js", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "leaflet.css", "use": "@vercel/static" },
    { "src": "leaflet.js", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
